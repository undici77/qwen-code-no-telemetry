{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "composite": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@lydell/node-pty": ["../../node_modules/@lydell/node-pty/node-pty.d.ts"],
      "@opentelemetry/api": ["./src/telemetry/dummy-otel.ts"],
      "@opentelemetry/sdk-logs": ["./src/telemetry/log-to-span-processor.ts"],
      "@opentelemetry/sdk-trace-base": [
        "./src/telemetry/log-to-span-processor.ts"
      ],
      "@opentelemetry/resources": ["./src/telemetry/log-to-span-processor.ts"],
      "@opentelemetry/sdk-node": ["./src/telemetry/sdk.ts"],
      "@opentelemetry/instrumentation-http": ["./src/telemetry/sdk.ts"],
      "*": ["node_modules/*", "../../node_modules/*"]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.json"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/__mocks__/**/*.ts"]
}
